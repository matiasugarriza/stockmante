# Stockmante — variables de entorno (copiar a .env)
# Nunca versionar .env (excluido en .gitignore).

# --- Base de datos PostgreSQL 15+ ---
DATABASE_URL=postgres://stockmante:stockmante@localhost:5432/stockmante

# --- Backend ---
# URL pública del frontend (CORS + links de correo)
APP_URL=http://localhost:5173
# Puerto del backend Axum
PORT=3000
# Entorno: development imprime la temporal en consola; production la silencia.
# Definilo explícitamente en cada entorno (si falta se asume development).
APP_ENV=development
# Documentación viva (Swagger UI en /docs y OpenAPI en /api-docs/openapi.json).
# Default: true fuera de producción y false con APP_ENV=production. Un valor
# explícito (true/false) siempre gana.
DOCS_ENABLED=true

# --- Sesiones (cookie HttpOnly) ---
SESSION_COOKIE_NAME=stockmante_sesion
# Duración absoluta de la sesión en horas (sin sliding) — spec: 8h hábiles
SESSION_EXPIRY_HOURS=8

# --- Correo (contraseña temporal) ---
EMAIL_FROM=soporte@stockmante.local
# Correo real (T029). En producción es obligatoria: sin SMTP_URL el arranque falla
# (no se pueden entregar credenciales). Vacía en dev: stub de consola (CorreoDev).
# Ejemplo: smtps://usuario:password@smtp.example.com:465
SMTP_URL=

# --- Frontend (Vite) ---
PUBLIC_API_URL=http://localhost:3000
