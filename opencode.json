{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "postgres": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@bytebase/dbhub@latest",
          "--config",
          "dbhub.toml"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-playwright"
        ]
      }
    }
  }
}
