  "query": "SELECT p.id, p.nombre, p.sku, p.codigo_barras, p.categoria_id,\n                  c.nombre AS categoria_nombre, p.unidad_medida, p.costo, p.precio_venta,\n                  p.stock_minimo, p.activo\n           FROM productos p\n           JOIN categorias c ON c.id = p.categoria_id\n           WHERE p.id = $1",
