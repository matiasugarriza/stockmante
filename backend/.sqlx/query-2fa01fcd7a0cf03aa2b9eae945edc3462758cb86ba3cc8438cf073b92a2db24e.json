{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.nombre, p.sku, p.codigo_barras, p.categoria_id,\n                  c.nombre AS categoria_nombre, p.unidad_medida, p.costo, p.precio_venta,\n                  p.stock_minimo, p.activo\n           FROM productos p\n           JOIN categorias c ON c.id = p.categoria_id\n           WHERE ($1::boolean IS NULL OR p.activo = $1)\n             AND ($2::int IS NULL OR p.categoria_id = $2)\n           ORDER BY p.id\n           LIMIT $3 OFFSET $4",
